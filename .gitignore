# Dependencies
node_modules/

# NOTE: package-lock.json is intentionally NOT ignored. Committing the lock file
# is what makes installs reproducible and `npm audit` results meaningful —
# without it, every deploy re-resolves transitive dependencies and can silently
# pull in a version that was never reviewed.
yarn.lock
pnpm-lock.yaml

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# Build outputs
dist/
dist-ssr/
build/
*.local

# Testing
coverage/

# Temporary files
tmp/
*.tmp
*.temp

# Audit/scanner reports (regenerated on demand, not source of truth)
a11y-report.json
audit-*.json

# OS files
Thumbs.db
desktop.ini

# MongoDB
*.db
data/

# Backend specific
backend/logs/
backend/tmp/
backend/uploads/

# Frontend specific
frontend/dist/
frontend/build/
frontend/.vite/
